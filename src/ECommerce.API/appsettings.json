{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "SeqUrl": "http://localhost:5341",
  "OtlpTracesEndpoint": "http://localhost:5341/ingest/otlp/v1/traces",
  "OtlpMetricsEndpoint": "http://localhost:5341/ingest/otlp/v1/metrics",
  "Jwt": {
    "Issuer": "ecommerce-api",
    "Audience": "ecommerce-client",
    "AccessTokenTtlMinutes": 15
  },
  "Auth": {
    "RequireVerifiedEmail": true,
    "MaxFailedLoginAttempts": 5,
    "LockoutDurationMinutes": 15,
    "RefreshTokenTtlDays": 30,
    "MaxFailedLoginAttemptsPerIp": 10,
    "LoginAttemptWindowMinutes": 5
  },
  "OAuth": {
    "Issuer": "https://localhost:5001",
    "Authority": "https://localhost:5001",
    "Clients": [
      {
        "ClientId": "ecommerce-web",
        "ClientSecret": "dev-secret-change-in-prod",
        "DisplayName": "Web App",
        "AllowedGrantTypes": ["authorization_code", "password"],
        "AllowedScopes": ["openid", "profile", "email", "orders.read", "orders.write"],
        "RedirectUris": ["http://localhost:3000/callback"],
        "IsActive": true
      },
      {
        "ClientId": "ecommerce-api-partner",
        "ClientSecret": "partner-secret-change-in-prod",
        "DisplayName": "Partner API",
        "AllowedGrantTypes": ["client_credentials"],
        "AllowedScopes": ["orders.read", "catalog.read"],
        "RedirectUris": [],
        "IsActive": true
      }
    ]
  },
  "Outbox": {
    "PollingIntervalSeconds": 2,
    "BatchSize": 50
  },
  "DataProvider": {
    "Provider": "Postgres"
  },
  "ConnectionStrings": {
    "SqlServer": ""
  },
  "ReverseProxy": {
    "Routes": {
      "api-route": {
        "ClusterId": "api-cluster",
        "Match": { "Path": "/proxy/api/{**catch-all}" },
        "Transforms": [{ "PathPattern": "/api/{**catch-all}" }]
      }
    },
    "Clusters": {
      "api-cluster": {
        "Destinations": {
          "api": { "Address": "http://localhost:5080/" }
        }
      }
    }
  },
  "Cors": {
    "AllowedOrigins": ["http://localhost:3000"]
  }
}
