# Normalize line endings: store LF in the repository on every platform.
# This keeps working trees consistent with .editorconfig (end_of_line = lf)
# so `dotnet format --verify-no-changes` passes on both Windows and Linux.

* text=auto

# Code and markup: force LF on checkout regardless of git core.autocrlf.
*.cs text eol=lf
*.csproj text eol=lf
*.props text eol=lf
*.targets text eol=lf
*.sln text eol=lf
*.slnx text eol=lf
*.editorconfig text eol=lf
*.json text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.tf text eol=lf
*.proto text eol=lf
*.sql text eol=lf
*.sh text eol=lf
*.ps1 text eol=lf
*.md text eol=lf
*.txt text eol=lf
*.toml text eol=lf
*.js text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
Dockerfile text eol=lf
.gitignore text eol=lf
.gitattributes text eol=lf
.dockerignore text eol=lf
.gitleaks.toml text eol=lf

# Binary assets: never normalize.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.webp binary
*.svg binary
*.bmp binary
*.pdf binary
*.zip binary
*.gz binary
