# Copy to deploy/staging/.env and adjust. Never commit .env.
# Values below match the defaults in docker-compose.staging.yml.

# Postgres
POSTGRES_USER=ecommerce
POSTGRES_PASSWORD=ecommerce_staging_pw
POSTGRES_DB=ecommerce_staging

# Redis
REDIS_PASSWORD=

# RabbitMQ
RABBITMQ_USER=ecommerce
RABBITMQ_PASSWORD=ecommerce_staging_pw

# API
API_PORT=8080
